# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Runtime artifacts (generated by 05-self-evolving-qc-agent)
*.log
**/logs/*.jsonl
!**/logs/.gitkeep
runtime/
*.sqlite3
*.db

# Model API keys and credentials — never commit these
.env
.env.*
*.key
*.pem
credentials*.json
secrets/

# Evaluation outputs that may embed dataset specifics
**/evaluations/*.json
!**/evaluations/.gitkeep

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Nested local scratch projects (created by IDEs, not part of the portfolio)
pythonProject/

# Jupyter
.ipynb_checkpoints/
